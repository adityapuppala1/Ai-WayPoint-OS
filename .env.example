# ─────────────────────────────────────────────────────────────────────────────
# Waypoint configuration.
#
# Copy this file to `.env.local` (or run `pnpm setup`, which does it for you and fills in
# fresh secrets). `.env.local` is git-ignored — never commit real secrets.
# Every value has a safe default for local development; production needs the
# ones marked REQUIRED IN PRODUCTION.
# ─────────────────────────────────────────────────────────────────────────────

# Public address of the app (used for links, cookies and passkeys).
WAYPOINT_URL=http://localhost:3000

# REQUIRED IN PRODUCTION. Signs sessions. 32+ random bytes, base64.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=

# REQUIRED IN PRODUCTION. Key-encryption key that protects each person's data key
# (journal, mood notes, health notes, trusted contacts, money data). 32 random bytes, base64.
# Losing it makes encrypted data unreadable — back it up like a password.
WAYPOINT_KEK=
# When rotating: move the old key here and put the new one in WAYPOINT_KEK.
WAYPOINT_KEK_PREVIOUS=

# ── Database ─────────────────────────────────────────────────────────────────
# Leave empty to use the built-in embedded Postgres (PGlite), stored in WAYPOINT_DATA_DIR.
# Nothing to install. One process at a time (stop `pnpm dev` before `pnpm db:seed`).
# For production use a real Postgres 16+ with the `vector` and `pg_trgm` extensions:
# DATABASE_URL=postgres://waypoint:password@localhost:5432/waypoint
DATABASE_URL=
WAYPOINT_DATA_DIR=.data
# Run migrations automatically on start (Postgres only; embedded always migrates).
WAYPOINT_AUTO_MIGRATE=
# Load starter circles and sourced signals on start (default on for embedded).
WAYPOINT_AUTO_SEED=
# Adds clearly-labelled EXAMPLE forecasts for demos. Never in production.
WAYPOINT_SEED_DEMO=false

# ── AI (all optional) ────────────────────────────────────────────────────────
# Without any key, Waypoint runs in "guided mode": Ask gives built-in guidance, Shield uses
# its rules engine, and plans come from the deterministic planner. Safety features never
# depend on AI.
# Providers are tried in this order; the first one with a key is used.
AI_PROVIDER_ORDER=anthropic,openai,google,ollama
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# A self-hosted model server (no data leaves your machine), e.g. http://localhost:11434
OLLAMA_BASE_URL=

# Model names per provider (small = fast/cheap, large = careful reasoning).
AI_MODEL_ANTHROPIC_SMALL=claude-haiku-4-5
AI_MODEL_ANTHROPIC_LARGE=claude-sonnet-5-5
AI_MODEL_OPENAI_SMALL=gpt-5.4-mini
AI_MODEL_OPENAI_LARGE=gpt-5.5
AI_MODEL_GOOGLE_SMALL=gemini-3.5-flash-lite
AI_MODEL_GOOGLE_LARGE=gemini-2.5-pro
AI_MODEL_OLLAMA_SMALL=llama3.2
AI_MODEL_OLLAMA_LARGE=llama3.1:8b

# Semantic search for memories and signals: none | openai | google | ollama
AI_EMBEDDING_PROVIDER=none
# Hard monthly spending cap across all AI features (USD). Guided mode takes over when reached.
AI_MONTHLY_BUDGET_USD=25
# Signs tool-approval requests (defaults to BETTER_AUTH_SECRET).
AI_TOOL_APPROVAL_SECRET=

# The judge (optional): TypeSafe's Jev gives typed second opinions (yes/no, one of N, a level)
# that can only add caution. It writes nothing. It is an outside service in the United States:
# asked only for people who allow outside AI, after personal details are removed, and named in
# the privacy notice once this key is set (https://console.typesafe.ai/keys). See docs/AI.md.
# TYPESAFE_API_KEY=
# The exact version asked. An alias such as jev-latest changes without notice, so Waypoint
# refuses to start with one (or with a partial version such as jev-1.13).
# AI_JUDGE_MODEL=jev-1.13.0
# Languages the judge is asked in (e.g. en,es). Measure before adding one, and measure English
# too before going live: pnpm --filter @waypoint/ai eval:judge (it fails for any language
# listed here that does not pass the Scam Shield release gates with the judge).
# AI_JUDGE_LOCALES=en

# ── Messaging channels (optional): SMS, WhatsApp and USSD ─────────────────────
# People can text HELP, CHECK + a message, or a question. Set up any one provider; see
# docs/CHANNELS.md for the webhook addresses to enter in each provider's console.
# Twilio (SMS and WhatsApp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_WHATSAPP_FROM=
# WhatsApp Cloud API (Meta)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Africa's Talking (SMS and USSD); username "sandbox" for testing
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
# A long random value (32+ characters) added to the callback addresses: Africa's Talking
# doesn't sign its callbacks. Generate: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
AFRICASTALKING_WEBHOOK_KEY=
# Shown on the website so people know where to text (e.g. +447700900123, *384*123#)
WAYPOINT_SMS_NUMBER=
WAYPOINT_WHATSAPP_NUMBER=
WAYPOINT_USSD_CODE=
# The most texts answered per hour and per day across every number (replies cost money; people
# in danger have a separate allowance of the same size). Defaults: 2000 and 20000.
WAYPOINT_TEXT_REPLIES_PER_HOUR=
WAYPOINT_TEXT_REPLIES_PER_DAY=
# Countries whose numbers get replies (ISO codes, e.g. KE,TZ,UG). Default: every country with
# help lines. Set your providers' geographic permissions to the same countries.
WAYPOINT_TEXT_COUNTRIES=

# ── Email (optional): confirmation links, password resets, invitations ─────────
# Without a provider, development prints emails in the terminal; production reports them failed.
EMAIL_FROM=
# Any SMTP server, e.g. smtp://user:password@smtp.example.org:587
SMTP_URL=
# Or Resend (https://resend.com)
RESEND_API_KEY=

# ── Accounts & organisations ─────────────────────────────────────────────────
# Extra origins allowed to call the API with cookies (comma-separated), e.g. a mobile dev server.
WEB_ORIGINS=
# Where the visitor's address comes from, for rate limits: the ONE header your own edge sets.
# Behind Cloudflare use cf-connecting-ip; behind nginx that sets X-Real-IP use x-real-ip.
# Default x-forwarded-for (right-most entry). Other such headers are ignored: visitors can send
# them too.
WAYPOINT_CLIENT_IP_HEADER=
# With X-Forwarded-For behind more than one proxy, list the proxies' addresses or CIDR ranges
# (comma-separated) so the visitor's own address is found. Not needed with a single header
# such as cf-connecting-ip.
TRUSTED_PROXIES=
# Smallest group any organisation dashboard will ever show (never below 20).
WAYPOINT_K_ANON_MIN=50
# Create this admin on first start (optional).
WAYPOINT_ADMIN_EMAIL=
WAYPOINT_ADMIN_PASSWORD=

# ── Privacy notice and terms (/privacy, /terms) ──────────────────────────────
# Who runs this Waypoint, as the notice and terms name them: legal name and postal address.
# Production warns at start until this and the contact address are set.
WAYPOINT_OPERATOR=
# Where people write about their information or the terms, e.g. privacy@example.org
WAYPOINT_CONTACT_EMAIL=
# Where security problems are reported (an email or https address), shown in
# /.well-known/security.txt. Defaults to WAYPOINT_CONTACT_EMAIL.
WAYPOINT_SECURITY_CONTACT=
# Where the servers and database are, e.g. "Frankfurt, Germany (Hetzner Online)" (optional).
WAYPOINT_DATA_LOCATION=
# How many days backups are kept, if you keep them (optional; the notice tells people).
WAYPOINT_BACKUP_DAYS=

# ── Operations ───────────────────────────────────────────────────────────────
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=

# ── Docker Compose only (infra/docker/compose.yml; see docs/DEPLOYMENT.md) ────
# The public name people will use, e.g. waypoint.example.org. The proxy gets its HTTPS
# certificate for this name, and WAYPOINT_URL becomes https://<this name>.
WAYPOINT_DOMAIN=
# REQUIRED. The database password: long and random, letters and digits only.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
POSTGRES_PASSWORD=
# The ports the proxy listens on (80 and 443 unless something else uses them).
HTTP_PORT=
HTTPS_PORT=
