# This folder sits inside XAMPP's htdocs, but Waypoint is a Node.js app — it is NOT
# meant to be served by Apache. Without this file, anyone who can reach your Apache
# server could download the source code and your .env.local secrets from
# http://localhost/Ai_WayPoint/. Run the app with `pnpm dev` and open
# http://localhost:3000 instead.

# Apache 2.4+
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>

# Apache 2.2 fallback
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
</IfModule>

Options -Indexes
