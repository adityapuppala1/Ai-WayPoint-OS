{
  "name": "@waypoint/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Waypoint web app and installable PWA (Next.js). Also hosts the API during development.",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
