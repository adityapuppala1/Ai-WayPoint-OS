    "@tanstack/react-query": "5.104.0",
    "@waypoint/ai": "workspace:*",
    "@waypoint/api": "workspace:*",
    "@waypoint/auth": "workspace:*",
    "@waypoint/content": "workspace:*",
    "@waypoint/core": "workspace:*",
    "@waypoint/db": "workspace:*",
    "@waypoint/i18n": "workspace:*",
    "@waypoint/tokens": "workspace:*",
    "@waypoint/ui": "workspace:*",
    "ai": "7.0.122",
    "better-auth": "1.7.6",
    "clsx": "2.1.1",
    "hono": "4.13.11",
    "next": "16.3.6",
    "next-intl": "4.14.7",
    "react": "19.3.0",
    "react-aria-components": "1.21.1",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "three": "0.186.1",
    "uqr": "0.1.3",
    "zod": "4.6.5"
