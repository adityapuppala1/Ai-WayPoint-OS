{
  "name": "@waypoint/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Waypoint HTTP API (Hono). Runs inside Next.js during development and as its own service in production.",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/zod-openapi": "1.6.3",
    "@waypoint/ai": "workspace:*",
    "@waypoint/auth": "workspace:*",
    "@waypoint/content": "workspace:*",
    "@waypoint/core": "workspace:*",
    "@waypoint/db": "workspace:*",
    "@waypoint/i18n": "workspace:*",
    "ai": "7.0.122",
    "drizzle-orm": "0.45.3",
    "fast-xml-parser": "5.11.2",
    "hono": "4.13.11",
    "nodemailer": "10.0.12",
    "zod": "4.6.5"
  }
}
