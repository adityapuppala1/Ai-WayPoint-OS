{
  "name": "@waypoint/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Drizzle schema and client. Embedded Postgres (PGlite) locally, node-postgres in production.",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./client": "./src/client.ts",
    "./seed": "./src/seed/index.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/cli.ts migrate",
    "seed": "tsx src/cli.ts seed",
    "reset": "tsx src/cli.ts reset",
    "studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@waypoint/content": "workspace:*",
    "@waypoint/core": "workspace:*",
    "drizzle-orm": "0.45.3",
    "pg": "8.23.0",
    "@electric-sql/pglite-pgvector": "0.0.9"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15"
  }
}
