{
  "name": "@waypoint/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Waypoint design system: accessible React components (React Aria) styled with wayfinding tokens.",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/index.css",
    "./icons": "./src/icons.ts"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-arabic": "5.3.0",
    "@fontsource-variable/noto-sans-bengali": "5.3.0",
    "@fontsource-variable/noto-sans-devanagari": "5.3.0",
    "@fontsource-variable/overpass": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "@waypoint/tokens": "workspace:*",
    "clsx": "2.1.1",
    "react-aria-components": "1.21.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
